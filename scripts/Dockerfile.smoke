FROM docker:29.0.0-cli@sha256:87858a6dd14149240f4a2c33e0ec0f32a5ac1bb2548c04f5a20694ea25cb6157 AS docker-cli
FROM python:3.13.8-alpine3.22@sha256:3a77fbbb5bc88c0f63cc2692a13b011547f25ee93536e991544c452801856226
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
WORKDIR /smoke
COPY verify-f02.py .
COPY verify-console.py .
COPY verify-f04.py .
COPY verify-f05.py .
COPY verify-f06.py .
ENTRYPOINT ["python", "-u", "/smoke/verify-f02.py"]
